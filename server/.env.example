# Server configuration
# Use BREADBUDDY_PORT to avoid conflicts with other apps that set PORT
BREADBUDDY_PORT=4000
CORS_ORIGIN=http://localhost:5173

# JWT secret - change this to a long random string in production
JWT_SECRET=change-this-to-a-super-secret-random-string-bestie

# Optional: custom database path
# DATABASE_PATH=./data/breadbuddy.db

# LLM chat (Feature A) — Google Gemini API key.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
# If unset, the AI chat endpoint returns 503 and the client falls back to
# the offline rule-based chatbot automatically.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-latest — Google's
# auto-updating alias for its current-generation Flash model, chosen
# specifically to avoid version-pinned model IDs getting retired or
# restricted to new API keys, which has already happened once this build
# — see HANDOFF.md).
# Only pin to a specific version (e.g. gemini-2.5-flash) if you've just
# confirmed it's live for your key at https://ai.google.dev/gemini-api/docs/models
# Check the server console log if replies seem generic/rule-based — a bad
# model ID or expired key will show up there as a Gemini API error.
# GEMINI_MODEL=gemini-flash-latest
